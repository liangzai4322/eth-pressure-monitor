[Unit]
Description=ETH Monitor Sync API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ethmonitor
Group=ethmonitor
EnvironmentFile=/etc/eth-monitor-api.env
Environment=ETH_MONITOR_DATA_DIR=/var/lib/eth-monitor-api
ExecStart=/usr/bin/python3 /opt/eth-monitor-api/api_server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/eth-monitor-api

[Install]
WantedBy=multi-user.target
